{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twinotify.app/schemas/notif-post.schema.json",
  "title": "NotifPostPayload",
  "type": "object",
  "required": [
    "v",
    "type",
    "canon_id",
    "app_name",
    "package_name",
    "id",
    "tag",
    "title",
    "text",
    "sub_text",
    "big_text",
    "visibility",
    "is_group_summary",
    "is_ongoing",
    "is_clearable",
    "small_icon_png_b64",
    "large_icon_png_b64",
    "ts"
  ],
  "properties": {
    "v": { "const": 1 },
    "type": { "type": "string", "enum": ["notif.post", "notif.update"] },
    "canon_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "app_name": { "type": ["string", "null"] },
    "package_name": { "type": "string", "minLength": 1 },
    "id": { "type": "integer" },
    "tag": { "type": ["string", "null"] },
    "title": { "type": ["string", "null"] },
    "text": { "type": ["string", "null"] },
    "sub_text": { "type": ["string", "null"] },
    "big_text": { "type": ["string", "null"] },
    "visibility": { "type": "string", "enum": ["public", "private", "secret"] },
    "is_group_summary": { "type": "boolean" },
    "is_ongoing": { "type": "boolean" },
    "is_clearable": { "type": "boolean" },
    "small_icon_png_b64": { "type": ["string", "null"], "contentEncoding": "base64" },
    "large_icon_png_b64": { "type": ["string", "null"], "contentEncoding": "base64" },
    "ts": { "type": "integer", "minimum": 0 },
    "is_auto_cancel": { "type": "boolean", "default": true },
    "conversation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "is_group",
        "messages"
      ],
      "properties": {
        "key": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "is_group": {
          "type": "boolean"
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "timestamp"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "timestamp": {
                "type": "integer",
                "minimum": 0
              },
              "sender_name": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 256
              },
              "sender_key": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 3,
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "title", "semantic", "reply"],
        "properties": {
          "action_id": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "minLength": 1, "maxLength": 64 },
          "semantic": { "type": "integer", "minimum": 0, "maximum": 12 },
          "reply": { "type": "boolean" },
          "reply_label": { "type": ["string", "null"], "maxLength": 64 }
        }
      }
    }
  },
  "additionalProperties": false
}
