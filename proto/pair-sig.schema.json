{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twinotify.app/schemas/pair-sig.schema.json",
  "type": "object",
  "required": ["v", "type", "pair_token", "confirmation_sig"],
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "type": { "type": "string", "const": "pair.sig" },
    "pair_token": { "type": "string", "minLength": 1 },
    "confirmation_sig": { "type": "string", "contentEncoding": "base64", "minLength": 1 }
  },
  "additionalProperties": false
}
