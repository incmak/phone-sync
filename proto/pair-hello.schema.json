{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twinotify.app/schemas/pair-hello.schema.json",
  "type": "object",
  "required": ["v", "type", "pair_token", "device_id", "enc_pubkey", "sign_pubkey"],
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "type": { "type": "string", "const": "peer.hello" },
    "pair_token": { "type": "string", "minLength": 1, "maxLength": 128 },
    "device_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "enc_pubkey": { "type": "string", "contentEncoding": "base64", "minLength": 44, "maxLength": 44 },
    "sign_pubkey": { "type": "string", "contentEncoding": "base64", "minLength": 44, "maxLength": 44 },
    "display_name": { "type": "string", "maxLength": 64 }
  },
  "additionalProperties": false
}
