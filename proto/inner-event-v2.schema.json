{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twinotify.app/schemas/inner-event-v2.schema.json",
  "type": "object",
  "required": ["v", "msg_id", "origin_device", "type", "created_at", "expires_at", "payload"],
  "properties": {
    "v": { "const": 2 },
    "msg_id": { "type": "string", "format": "uuid" },
    "origin_device": { "type": "string", "minLength": 1, "maxLength": 128 },
    "type": { "type": "string", "enum": ["notif.post", "notif.update", "notif.cancel", "notif.action.invoke", "notif.action.result", "call.state", "call.control.invoke", "call.control.result", "peer.receipt", "peer.probe", "lan.bootstrap", "state.digest", "state.snapshot.begin", "state.snapshot.item", "state.snapshot.end", "unpair"] },
    "canon_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "sequence": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "integer", "minimum": 0 },
    "expires_at": { "type": "integer", "minimum": 0 },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "enum": ["notif.post", "notif.update", "notif.cancel", "state.snapshot.item"] } } },
      "then": { "required": ["canon_id", "sequence"] }
    },
    {
      "if": { "properties": { "type": { "const": "call.state" } } },
      "then": {
        "required": ["canon_id", "sequence"],
        "properties": {
          "canon_id": { "type": "string", "pattern": "^call:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
          "payload": {
            "type": "object",
            "required": ["call_session_id", "state", "direction"],
            "properties": {
              "call_session_id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
              "state": { "type": "string", "enum": ["ringing", "active", "idle"] },
              "direction": { "type": "string", "enum": ["incoming", "outgoing", "unknown"] },
              "controls": {
                "type": "array",
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "required": ["control_id", "kind"],
                  "properties": {
                    "control_id": { "type": "string", "format": "uuid" },
                    "kind": { "type": "string", "enum": ["answer", "decline", "hang_up"] }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "required": ["controls"],
                  "properties": { "controls": { "minItems": 1 } }
                },
                "then": {
                  "oneOf": [
                    {
                      "properties": {
                        "state": { "const": "ringing" },
                        "direction": { "const": "incoming" },
                        "controls": {
                          "minItems": 2,
                          "maxItems": 2,
                          "allOf": [
                            {
                              "contains": {
                                "type": "object",
                                "properties": { "kind": { "const": "answer" } },
                                "required": ["kind"]
                              },
                              "minContains": 1,
                              "maxContains": 1
                            },
                            {
                              "contains": {
                                "type": "object",
                                "properties": { "kind": { "const": "decline" } },
                                "required": ["kind"]
                              },
                              "minContains": 1,
                              "maxContains": 1
                            }
                          ]
                        }
                      }
                    },
                    {
                      "properties": {
                        "state": { "const": "active" },
                        "direction": { "const": "incoming" },
                        "controls": {
                          "minItems": 1,
                          "maxItems": 1,
                          "contains": {
                            "type": "object",
                            "properties": { "kind": { "const": "hang_up" } },
                            "required": ["kind"]
                          },
                          "minContains": 1,
                          "maxContains": 1
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["call.control.invoke", "call.control.result"] } } },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["canon_id"] },
            { "required": ["sequence"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "call.control.invoke" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["invocation_id", "canon_id", "call_session_id", "call_sequence", "control_id", "kind", "invoked_at"],
            "properties": {
              "invocation_id": { "type": "string", "format": "uuid" },
              "canon_id": { "type": "string", "pattern": "^call:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
              "call_session_id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
              "call_sequence": { "type": "integer", "minimum": 1 },
              "control_id": { "type": "string", "format": "uuid" },
              "kind": { "type": "string", "enum": ["answer", "decline", "hang_up"] },
              "invoked_at": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "call.control.result" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["invocation_id", "canon_id", "kind", "status"],
            "properties": {
              "invocation_id": { "type": "string", "format": "uuid" },
              "canon_id": { "type": "string", "pattern": "^call:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
              "kind": { "type": "string", "enum": ["answer", "decline", "hang_up"] },
              "status": {
                "type": "string",
                "enum": ["dispatched", "outcome_unknown", "capability_gone", "call_gone", "stale_state", "expired", "failed"]
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "notif.action.invoke" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["invocation_id", "canon_id", "action_id", "notification_sequence", "invoked_at"],
            "properties": {
              "invocation_id": { "type": "string", "format": "uuid" },
              "canon_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "action_id": { "type": "string", "format": "uuid" },
              "notification_sequence": { "type": "integer", "minimum": 1 },
              "reply_text": { "type": "string", "maxLength": 4096 },
              "invoked_at": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "notif.action.result" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["invocation_id", "canon_id", "status"],
            "properties": {
              "invocation_id": { "type": "string", "format": "uuid" },
              "canon_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "status": {
                "type": "string",
                "enum": ["dispatched", "outcome_unknown", "action_gone", "notification_gone", "expired", "failed"]
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["lan.bootstrap", "peer.probe"] } } },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["canon_id"] },
            { "required": ["sequence"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "lan.bootstrap" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["protocol_version", "tls_spki_sha256", "binding_context_sha256"],
            "properties": {
              "protocol_version": { "const": 1 },
              "tls_spki_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "binding_context_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "peer.probe" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["probe_id", "sent_at", "request_direct"],
            "properties": {
              "probe_id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
              "sent_at": { "type": "integer", "minimum": 0 },
              "request_direct": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
