{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twinotify.app/schemas/packet.schema.json",
  "title": "Packet",
  "description": "Legacy v1 cleartext packet; never use for encrypted WebSocket validation",
  "type": "object",
  "required": ["v", "type", "msg_id", "origin_device", "ts"],
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "type": {
      "type": "string",
      "enum": ["ping", "pong", "notif.post", "notif.update", "notif.cancel", "ack", "unpair"]
    },
    "msg_id": { "type": "string", "format": "uuid" },
    "origin_device": { "type": "string", "minLength": 1 },
    "ts": { "type": "integer", "description": "Origin wall-clock millis; advisory only." },
    "payload": { "type": ["object", "null"] }
  }
}
