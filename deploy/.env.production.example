# Public DNS name whose A/AAAA records point to the relay host.
TWINOTIFY_DOMAIN=relay.example.com

# Copy the immutable digest reference printed by the relay image workflow.
TWINOTIFY_RELAY_IMAGE=ghcr.io/incmak/twinotify-relay@sha256:REPLACE_WITH_64_HEX_CHARACTERS

# Use the matching release tag or commit identifier surfaced by /health.
TWINOTIFY_BUILD_VERSION=relay-v0.1.0
