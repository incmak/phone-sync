{
  "expo": {
    "name": "Twinotify",
    "slug": "twinotify",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "twinotify",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.twinotify.app"
    },
    "android": {
      "package": "com.twinotify.app",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#DCEBE1"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 34
          }
        }
      ],
      "./plugins/with-optional-camera",
      "./plugins/with-android-toolchain-workarounds",
      "./plugins/with-android-security",
      "expo-asset",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E3E9E5",
          "dark": {
            "image": "./assets/brand/splash.png",
            "backgroundColor": "#111815"
          }
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eb10d340-9784-4257-80b2-1e4d3a36e74e"
      }
    },
    "owner": "incmak"
  }
}
