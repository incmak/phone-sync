{
  "cli": {
    "version": "22.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "release-apk": {
      "developmentClient": false,
      "distribution": "internal",
      "environment": "production",
      "android": { "buildType": "apk" }
    },
    "production": {
      "developmentClient": false,
      "distribution": "store",
      "environment": "production",
      "android": { "buildType": "app-bundle" }
    }
  }
}
